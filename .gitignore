# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.tox/

# Node / client
node_modules/
client/dist/

# Built client bundle. Regenerated by `pnpm build`; committing it would put a
# minified 77-chunk tree in every diff. Release builds ship it in the wheel.
src/rstview/client/

# Editors / OS
# .vscode/launch.json and tasks.json are how the extension is run in the
# Extension Development Host, so they are shared, not ignored.
.vscode/settings.json
.idea/
*.swp
.DS_Store

# VS Code extension build output. `media/` is the client bundle built with
# VITE_TARGET=vscode; `out/` is compiled TypeScript. Both are regenerated.
extension/media/
extension/out/
# Vendored Python runtime (docutils + rstview), rebuilt by `pnpm run vendor`.
# Reproducible from pyproject.toml, so it is build output, not source.
extension/python/
*.vsix
